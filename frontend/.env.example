# Copy to .env (gitignored) and fill in with the values from `terraform
# output` after applying the main config. These are safe as public
# build-time values — this is a public PKCE client with no secret.

VITE_COGNITO_DOMAIN=https://flash-cards-<account-id>.auth.eu-north-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=<cognito_app_client_id output>
VITE_REDIRECT_URI=https://<cloudfront_domain output>/
